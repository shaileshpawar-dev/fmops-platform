# Keep the build context small and secrets out of images.
.git
.github
.venv
venv
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage*
coverage.xml

# Secrets must never enter an image layer.
.env
.env.*
!.env.example
*.pem
*.key
credentials

# Generated state: containers build their own.
artifacts/
mlruns/
data/raw
data/processed
data/reference
*.joblib
*.pkl
*.db

# Not needed at runtime.
terraform/
monitoring/
docs/
tests/
*.md
!README.md
Makefile
docker-compose.yml
.dvc/cache
