# --- secrets: never commit these ---------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials
secrets.yaml
*_credentials.json

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg

# --- virtualenvs --------------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- tooling caches -----------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.hypothesis/

# --- platform state -----------------------------------------------------------
# Model artifacts, the registry database, MLflow runs and reports are generated,
# not source. `make demo` recreates all of it.
artifacts/
mlruns/
mlflow.db
*.joblib
*.pkl

# --- data ---------------------------------------------------------------------
# Datasets are generated deterministically by `fmops data generate` and tracked
# by content hash (and by DVC when enabled). The payloads stay out of git; the
# .dvc POINTER FILES are committed -- that is the whole point of DVC.
#
# Note the `data/raw/*` form rather than `data/raw/`: git cannot re-include a
# file whose parent DIRECTORY is excluded, so excluding the directory would
# silently swallow the .dvc pointers below.
data/raw/*
!data/raw/*.dvc
!data/raw/.gitkeep

data/processed/*
!data/processed/*.dvc
!data/processed/.gitkeep

data/reference/*
!data/reference/*.dvc
!data/reference/.gitkeep

data/sample/*.csv
!data/sample/*.dvc

# The dataset manifest records absolute local paths, so it is per-machine and
# regenerated by `fmops data generate`. Lineage that must survive lives in the
# .dvc pointers and in the dataset_version/dataset_hash on each model version.
data/versions.json

# --- DVC ----------------------------------------------------------------------
/.dvc/cache
/.dvc/tmp
/.dvc/config.local

# --- terraform ----------------------------------------------------------------
# State can contain resource metadata and must never be committed.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Saved plans embed the resolved values of every variable, secrets included.
*.tfplan
crash.log
crash.*.log
backend.tf
!backend.tf.example
override.tf
override.tf.json
*_override.tf

# --- editors / OS -------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- misc ---------------------------------------------------------------------
*.log
logs/
tmp/
.ipynb_checkpoints/
node_modules/
