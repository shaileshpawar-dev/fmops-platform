// Remote state. Copy to backend.tf and fill in your own bucket/table.
//
// Local state is fine for a solo experiment, but the moment more than one
// person or one CI job runs terraform, you need remote state with locking --
// otherwise two concurrent applies will corrupt each other.
//
// Bootstrap the backend once (it cannot manage its own state):
//
//   aws s3api create-bucket --bucket my-tfstate-bucket --region us-east-1
//   aws s3api put-bucket-versioning --bucket my-tfstate-bucket \
//       --versioning-configuration Status=Enabled
//   aws dynamodb create-table --table-name terraform-locks \
//       --attribute-definitions AttributeName=LockID,AttributeType=S \
//       --key-schema AttributeName=LockID,KeyType=HASH \
//       --billing-mode PAY_PER_REQUEST

terraform {
  backend "s3" {
    bucket         = "REPLACE-ME-tfstate"
    key            = "fmops/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "terraform-locks"
    encrypt        = true
  }
}
