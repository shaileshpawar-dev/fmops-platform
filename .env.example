# FMOps configuration.
#
# Copy to .env and edit. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Precedence (highest wins):
#   1. process environment variables
#   2. .env
#   3. configs/<FMOPS_ENV>.yaml
#   4. defaults in app/core/config.py
#
# Nested settings use a double underscore: FMOPS_DRIFT__THRESHOLD maps to
# settings.drift.threshold.
#
# THE PLATFORM RUNS FULLY WITHOUT ANY OF THESE SET. Every value below has a
# working default, and the LLM layer falls back to a deterministic offline
# provider when no API key is present.

# ============================================================================
# Core
# ============================================================================
FMOPS_ENV=development
FMOPS_LOG_LEVEL=INFO
# json for machine collection (CloudWatch/Loki), console for local development
FMOPS_LOG_FORMAT=console
# Usually injected by CI; falls back to `git rev-parse HEAD`.
# FMOPS_GIT_COMMIT=

# ============================================================================
# Approval gate -- what a model must clear before it can reach production
# ============================================================================
# FMOPS_APPROVAL__MIN_F1=0.60
# FMOPS_APPROVAL__MIN_ROC_AUC=0.70
# FMOPS_APPROVAL__MAX_INFERENCE_LATENCY_MS=250
# Minimum improvement over the incumbent before a candidate replaces it.
# Setting this to 0 lets run-to-run noise churn your production model.
# FMOPS_APPROVAL__MIN_IMPROVEMENT=0.005
# FMOPS_APPROVAL__COMPARISON_METRIC=roc_auc
# FMOPS_APPROVAL__REQUIRE_MANUAL_APPROVAL=false

# ============================================================================
# Deployment
# ============================================================================
# local (in-process routing) or sagemaker
# FMOPS_DEPLOYMENT__PROVIDER=local
# blue_green | canary | shadow | direct
# FMOPS_DEPLOYMENT__STRATEGY=blue_green
# FMOPS_DEPLOYMENT__ENDPOINT_NAME=fmops-loan-default
# FMOPS_DEPLOYMENT__AUTO_ROLLBACK=true
# FMOPS_DEPLOYMENT__CANARY_MIN_REQUESTS_PER_STEP=20

# ============================================================================
# Drift detection
# ============================================================================
# FMOPS_DRIFT__THRESHOLD=0.20
# FMOPS_DRIFT__MIN_SAMPLES=200
# Fraction of features that must drift before the dataset is called drifted.
# FMOPS_DRIFT__DATASET_DRIFT_SHARE=0.30
# native (built in) or evidently (requires the [quality] extra)
# FMOPS_DRIFT__ENGINE=native

# ============================================================================
# Retraining
# ============================================================================
# FMOPS_RETRAINING__ENABLED=true
# FMOPS_RETRAINING__AUTO_DEPLOY_IF_BETTER=true
# Suppresses repeat triggers while a condition persists.
# FMOPS_RETRAINING__COOLDOWN_MINUTES=60

# ============================================================================
# Monitoring
# ============================================================================
# FMOPS_MONITORING__LATENCY_SLO_MS=250
# FMOPS_MONITORING__ERROR_RATE_SLO=0.02
# How often the background sampler measures CPU/memory/GPU.
# FMOPS_MONITORING__RESOURCE_SAMPLE_SECONDS=15
# Counting open file descriptors costs ~1.8s on Windows. Off by default; turn
# it on only when hunting a descriptor leak.
# FMOPS_MONITORING__SAMPLE_OPEN_FILES=false
# Sampling reduces write load but weakens drift statistics.
# FMOPS_MONITORING__PREDICTION_LOG_SAMPLE_RATE=1.0

# ============================================================================
# Alerts
# ============================================================================
# FMOPS_ALERTS__SINKS=["log","database"]
# FMOPS_ALERTS__WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# FMOPS_ALERTS__SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:fmops-alerts

# ============================================================================
# Experiment tracking and registry
# ============================================================================
# Defaults to a local SQLite store under artifacts/mlruns/.
# Point at a tracking server for anything shared:
# FMOPS_TRACKING__TRACKING_URI=http://localhost:5000
# local (SQLite) or mlflow
# FMOPS_TRACKING__REGISTRY_BACKEND=local
# FMOPS_TRACKING__EXPERIMENT_NAME=fmops-loan-default

# ============================================================================
# LLMOps
# ============================================================================
# mock | bedrock | anthropic | gemini | openai_compatible
# 'mock' is deterministic and offline: no key needed, no network, no cost.
FMOPS_LLM__PROVIDER=mock
FMOPS_LLM__MODEL=mock-small
# FMOPS_LLM__TEMPERATURE=0.0
# FMOPS_LLM__MAX_TOKENS=512
# FMOPS_LLM__SAFETY_ENABLED=true
# FMOPS_LLM__DAILY_COST_BUDGET_USD=25.0

# --- provider credentials ---------------------------------------------------
# Supply ONLY the one matching FMOPS_LLM__PROVIDER. Never commit a real key.
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# OPENAI_API_KEY=sk-...
# Any OpenAI-compatible server (vLLM, Ollama, LM Studio, Together, Groq):
# OPENAI_BASE_URL=http://localhost:11434/v1

# ============================================================================
# AWS -- entirely optional; the platform is fully functional without it
# ============================================================================
FMOPS_AWS__ENABLED=false
# FMOPS_AWS__REGION=us-east-1
# FMOPS_AWS__S3_BUCKET=my-fmops-artifacts
# FMOPS_AWS__S3_PREFIX=fmops
# FMOPS_AWS__SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/fmops-sagemaker
# FMOPS_AWS__SAGEMAKER_TRAINING_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/fmops/training:latest
# FMOPS_AWS__BEDROCK_REGION=us-east-1

# Prefer an instance role, SSO or `aws configure` over static keys. These exist
# only for local development against AWS and are redacted from every config
# dump and log line.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ============================================================================
# API security
# ============================================================================
# none (development) or api_key
FMOPS_SECURITY__AUTH_BACKEND=none
# Required when auth_backend=api_key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# FMOPS_SECURITY__API_KEYS=["replace-with-a-generated-key"]
# FMOPS_SECURITY__CORS_ALLOW_ORIGINS=["https://app.example.com"]
# FMOPS_SECURITY__MAX_BATCH_ROWS=1000

# ============================================================================
# Server
# ============================================================================
# FMOPS_SERVER__PORT=8000
# FMOPS_SERVER__WORKERS=1
# Disable the interactive docs in production.
# FMOPS_SERVER__DOCS_ENABLED=true

# ============================================================================
# Local stack (docker-compose)
# ============================================================================
# GRAFANA_USER=admin
# GRAFANA_PASSWORD=change-me
# MINIO_USER=fmopsadmin
# MINIO_PASSWORD=change-me
